# syntax=docker/dockerfile:1
# Multi-platform build for Apple Silicon

FROM --platform=linux/arm64 node:20-alpine AS build

# Security: Create non-root user for build stage
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nuxt -u 1001

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./
RUN npm ci --only=production --ignore-scripts && \
    npm cache clean --force

# Install sass as dev dependency 
RUN npm install --save-dev sass

# Copy source code
COPY --chown=nuxt:nodejs . .

# Build application
RUN npm run build && \
    rm -rf node_modules && \
    npm ci --only=production --ignore-scripts

# Production stage
FROM --platform=linux/arm64 node:20-alpine AS app

# Security: Use non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nuxt -u 1001

WORKDIR /app

# Install nginx with Lua support and other necessary packages
RUN apk add --no-cache \
    nginx \
    nginx-mod-devel-kit \
    nginx-mod-http-lua \
    supervisor \
    curl \
    bash \
    && rm -rf /var/cache/apk/* 

# Copy configuration files
COPY --chown=nuxt:nodejs scripts/entry.sh ./scripts/entry.sh
COPY --chown=nuxt:nodejs nginx/ /etc/nginx/

# Copy built application from build stage
COPY --chown=nuxt:nodejs --from=build /app/.output ./.output/
COPY --chown=nuxt:nodejs --from=build /app/node_modules ./node_modules/
COPY --chown=nuxt:nodejs --from=build /app/package.json ./

# Setup directories and permissions for nginx and supervisord
RUN mkdir -p /var/run/nginx /var/log/nginx /var/lib/nginx/logs /app/log /run/nginx /run /tmp && \
    chown -R nuxt:nodejs /var/run/nginx /var/log/nginx /var/lib/nginx /etc/nginx /run/nginx /run /app /tmp && \
    chmod +x /app/scripts/entry.sh && \
    # Create nginx log and PID files with proper permissions
    touch /var/log/nginx/access.log /var/log/nginx/error.log /var/lib/nginx/logs/error.log /run/nginx.pid && \
    chown nuxt:nodejs /var/log/nginx/access.log /var/log/nginx/error.log /var/lib/nginx/logs/error.log /run/nginx.pid && \
    chmod 644 /run/nginx.pid

# Set timezone
ENV TZ=America/New_York
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Switch to non-root user
USER nuxt

# Document the port
EXPOSE 8080

# Use exec form for better signal handling
ENTRYPOINT ["./scripts/entry.sh"]